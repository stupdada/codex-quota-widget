{
  "name": "codex-token-dashboard",
  "version": "0.3.3",
  "description": "Codex Token dashboard with an integrated LED quota widget for Windows.",
  "main": "src/main/main.js",
  "author": "Codex Quota Widget Contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/stupdada/codex-quota-widget.git"
  },
  "homepage": "https://github.com/stupdada/codex-quota-widget#readme",
  "bugs": {
    "url": "https://github.com/stupdada/codex-quota-widget/issues"
  },
  "keywords": [
    "codex",
    "codex-quota",
    "codex-usage",
    "quota-widget",
    "desktop-widget",
    "electron",
    "codex额度",
    "codex额度小组件",
    "codex额度悬浮球",
    "codex用量"
  ],
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test:quota-signal": "node scripts/verify-quota-signal.js",
    "test:dashboard-client": "node scripts/verify-token-dashboard-client.js",
    "test:dashboard-runtime": "node scripts/verify-dashboard-runtime.js",
    "test": "npm run test:quota-signal && npm run test:dashboard-client && npm run test:dashboard-runtime",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable",
    "build:dir": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir",
    "build:backend": "python -m PyInstaller --noconfirm --distpath backend --workpath build/backend backend/source/packaging/CodexTokenDashboard-Slim.spec",
    "prebuild": "npm run build:backend",
    "prebuild:dir": "npm run build:backend"
  },
  "build": {
    "appId": "cn.codex.token.dashboard",
    "productName": "Codex 用量监控",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/history/**/*",
      "!src/main/pace-advice.js",
      "!src/main/quota-service.js",
      "!src/main/quota-store.js",
      "!src/shared/quota-history-chart.js",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "assets/app-icon-tray-16.png",
      "assets/app-icon-256.png",
      "assets/codex-token-dashboard.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "CodexTokenDashboard-Slim.exe"
        ]
      }
    ],
    "win": {
      "icon": "assets/codex-token-dashboard.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CodexTokenDashboard.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
